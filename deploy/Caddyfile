{
	email {$ACME_EMAIL}
}

{$SITE_DOMAIN} {
	encode zstd gzip
	reverse_proxy web:3000
}

www.{$SITE_DOMAIN} {
	redir https://{$SITE_DOMAIN}{uri} permanent
}

{$API_DOMAIN} {
	request_body {
		max_size 16MB
	}
	handle_path /media/* {
		@notWebp not path *.webp
		respond @notWebp 404
		root * /srv/media
		@exists file
		header @exists Cache-Control "public, max-age=31536000, immutable"
		header X-Content-Type-Options nosniff
		file_server
	}
	handle {
		reverse_proxy api:3000
	}
}
