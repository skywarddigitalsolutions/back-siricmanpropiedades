# Production environment for the ~/siricman deploy on the VPS.
# Copy this file to ".env" next to compose.yml and fill in every value
# marked CHANGE_ME. Never commit the real ".env" - only this example.

# --- Domains and TLS (used by Caddy) ---
# Apex domain that serves the public site (www redirects here).
SITE_DOMAIN=<dominio>
# Subdomain that serves the API.
API_DOMAIN=api.<dominio>
# Address Let's Encrypt uses for expiry/abuse notices.
ACME_EMAIL=CHANGE_ME@example.com

# --- Postgres (official postgres:16-alpine image vars) ---
# Keep these three in sync with DB_USER / DB_PASSWORD / DB_NAME below - the
# "db" service and the "api" service read the same credentials from two
# different variable names, so a mismatch locks the API out of its own
# database.
POSTGRES_USER=siricman
POSTGRES_PASSWORD=CHANGE_ME_use_openssl_rand_hex_32
POSTGRES_DB=siricman

# --- Back (NestJS) ---
NODE_ENV=production

# Same values as POSTGRES_USER / POSTGRES_PASSWORD / POSTGRES_DB above.
# DB_HOST is forced to "db" by compose.yml regardless of what is set here.
DB_HOST=db
DB_PORT=5432
DB_USER=siricman
DB_PASSWORD=CHANGE_ME_use_openssl_rand_hex_32
DB_NAME=siricman

# The schema is versioned with migrations, which always run on boot
# (migrationsRun: true in app.module.ts). Never enable synchronize in
# production.
DB_SYNCHRONIZE=false

# JWT secret: random string of at least 32 characters (the app refuses to
# boot with the .env.example placeholder or a shorter value).
# Generate one with: openssl rand -hex 32
JWT_SECRET=CHANGE_ME_use_openssl_rand_hex_32
JWT_EXPIRES_IN=60m

# Behind Caddy (a reverse proxy), trust the first hop so rate limiting and
# request logging see the real client IP instead of Caddy's.
TRUST_PROXY=1

# Comma-separated list of allowed CORS origins. Must be the public site
# origin(s); wiring the front to call this API comes with a later feature.
CORS_ORIGINS=https://<dominio>

# Days to keep audit_logs rows before a scheduled job deletes them.
AUDIT_LOG_RETENTION_DAYS=365

# MFA (TOTP) - AES-256-GCM key used to encrypt TOTP secrets at rest.
# Generate one with: openssl rand -hex 32 (must be exactly 64 hex chars).
# Losing or rotating this key invalidates every enrolled user's MFA secret.
MFA_ENCRYPTION_KEY=CHANGE_ME_use_openssl_rand_hex_32
MFA_ISSUER=Siricman Propiedades

# Seed: the app refuses to seed in production with the public example
# passwords from .env.example. For the FIRST deploy only, set RUN_SEED=true
# together with strong, unique SEED_*_PASSWORD values below so the initial
# admin/manager/user accounts get created; after that first successful boot,
# set RUN_SEED=false (the seed only ever runs once, but leaving it "true"
# with weak passwords is a needless risk if it is ever re-triggered).
RUN_SEED=true
# Login passwords: 6-50 chars with uppercase, lowercase and a number
# (openssl rand -hex 32 does NOT qualify). Generate each one with:
#   echo "Sm$(openssl rand -hex 12)"
SEED_ADMIN_PASSWORD=CHANGE_ME_login_password
SEED_MANAGER_PASSWORD=CHANGE_ME_login_password
SEED_USER_PASSWORD=CHANGE_ME_login_password

# Interactive API docs at /docs. Off unless set to exactly "true" (the
# default) - it is not itself an access control, just avoids publishing the
# full schema. Keep it false in production.
SWAGGER_ENABLED=false

# Public base URL Caddy serves property photos from (see deploy/README.md
# section 6). No trailing slash - the API does not start in production if
# this is missing.
MEDIA_PUBLIC_BASE_URL=https://api.<dominio>/media
