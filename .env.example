# Conexión a PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=your_db_password
DB_NAME=auth_roles_db

# Establecer en "true" solo en desarrollo local para permitir que TypeORM sincronice automáticamente el esquema
# a partir de las entidades. Dejar sin definir o en "false" en cualquier otro entorno - el esquema se gestiona
# mediante migraciones (npm run migration:run), las cuales siempre se ejecutan al iniciar.
DB_SYNCHRONIZE=false

# Secreto de JWT: cadena aleatoria de al menos 32 caracteres (la app se niega
# a arrancar con este placeholder o con un valor más corto).
# Genera uno con: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=your_super_secret_jwt_key_change_in_production

# Tiempo de vida de los tokens de sesión (formato ms: "60m", "1h", "7d")
JWT_EXPIRES_IN=60m

# Detrás de un proxy/load balancer (Railway, Render, Cloudflare, nginx),
# establecer en "1" para que el rate limiting vea la IP real del cliente y
# no la del proxy. Dejar vacío o "false" si la app recibe tráfico directo.
TRUST_PROXY=

# Lista de orígenes CORS permitidos separados por comas
CORS_ORIGINS=http://localhost:3000

# Cuántos días conservar las filas de audit_logs antes de que una tarea programada las elimine
AUDIT_LOG_RETENTION_DAYS=365

# MFA (TOTP) - Clave AES-256-GCM utilizada para cifrar los secretos TOTP en reposo.
# Genera una con: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Debe tener exactamente 64 caracteres hexadecimales (32 bytes). Perder o rotar esta clave
# invalida el secreto MFA de todos los usuarios que ya se hayan registrado.
MFA_ENCRYPTION_KEY=
# Se muestra como el emisor de la cuenta (Nombre de aplicacion o servicio)dentro de la aplicación de autenticación (Google Authenticator, etc.)
MFA_ISSUER=BaseAuth

# Seed: establecer en "true" para ejecutar la semilla inicial al iniciar (solo se ejecuta una vez).
# IMPORTANTE: estas contraseñas de ejemplo son públicas (están en el repo).
# Con NODE_ENV=production la app se niega a sembrar si siguen siendo estas.
RUN_SEED=true
SEED_ADMIN_PASSWORD=Admin1234!
SEED_MANAGER_PASSWORD=Manager1234!
SEED_USER_PASSWORD=User1234!

# Documentación interactiva (Swagger) en /docs. Poné "false" en producción
# si no querés exponer públicamente el esquema completo de la API.
SWAGGER_ENABLED=true
